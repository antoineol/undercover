{
  "name": "undercover",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "firsttimelogin": "convex dev",
    "dev": "npm-run-all2 --parallel dev:backend dev:frontend",
    "dev:backend": "convex dev",
    "dev:frontend": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "test": "bun test",
    "lint": "eslint --fix",
    "upgr": "bun upgrade && bun update --interactive",
    "build:prod": "bunx convex deploy --cmd 'bun run build'"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "convex": "^1.30.0",
    "memoize-one": "^6.0.0",
    "next": "16.0.10",
    "qrcode": "^1.5.4",
    "react": "19.2.1",
    "react-animate-height": "^3.2.3",
    "react-dom": "19.2.1",
    "react-hook-form": "^7.68.0",
    "zod": "^4.1.13",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.3",
    "@tailwindcss/postcss": "^4.1.17",
    "@trivago/prettier-plugin-sort-imports": "^6.0.0",
    "@types/memoize-one": "^5.1.2",
    "@types/node": "^24.10.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "bun-types": "^1.3.3",
    "eslint": "^9.39.1",
    "eslint-config-flat-gitignore": "^2.1.0",
    "eslint-config-next": "16.0.7",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "npm-run-all2": "^8.0.4",
    "prettier": "^3.7.4",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "tailwindcss": "^4.1.17",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.48.1"
  },
  "packageManager": "bun@1.0.0"
}
